<style>
  .course-head {
    display: flex;
    justify-content: center;
  }

  .course-body {
    display: flex;
    justify-content: space-around;
    border-style: solid;
    border-width: 0px 0px 0px 2px;
    border-color: orange;
  }

  .heading {
    display: flex;
    flex-direction: row;
  }

  .item {
/*    display: flex;
    flex: 2 2 50%;
    flex-direction: row;
    flex-wrap:wrap;
    justify-content: space-around;
    flex-basis: auto;*/
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 450px));
    grid-column-gap: 6rem;
    grid-auto-columns: 50%;

  }

  article {
    flex-shrink: 4;
    align-self: auto;
  }
  
  #more {
  display: none;
  }

  a {
    color:#7f7dd7;
    margin:4px;
    padding:2px;
    font-size: small;
  }
</style>

<div class="container">
  <div class="heading" style="margin: 2rem; padding: auto">
    <div class="course-head col-md-5"><h1 style="justify-content: space-around; margin-right: 18px; padding: auto">Courses</h1></div>
    <div class="course-body col-md-5"><p style="justify-content: space-around; margin-left: 24px; padding: auto">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut elit tellus, luctus nec ullamcorper mattis,<span id="dots">...</span><span id="more"> pulvinar dapibus leo. Ut enim ad minim.</span><a href="#" onclick="myFunction()" id="myBtn">Read more</a></p></div>
  </div>
  <div class="item">
    {{#each courses}}
    <article>
      <img width="400" height="223" src="{{this.imgUrl}}" alt="course-pic">
      <h3>{{this.name}}</h3>
			<p>{{this.description}}</p>
			<p><a class="btn btn-primary" role="button" href="/api/courses/{{this.id}}">Start here</a></p>
			<hr>
    </article>
    {{/each}}
  </div>
</div>

<script>
function myFunction() {
  var dots = document.getElementById("dots");
  var moreText = document.getElementById("more");
  var btnText = document.getElementById("myBtn");

  if (dots.style.display === "none") {
    dots.style.display = "inline";
    btnText.innerHTML = "Read more"; 
    moreText.style.display = "none";
  } else {
    dots.style.display = "none";
    btnText.innerHTML = "Read less"; 
    moreText.style.display = "inline";
  }
}
</script>